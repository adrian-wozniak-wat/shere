# Database Credentials
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=ha_emotion_research
DB_USER=admin
DB_PASSWORD=admin123
DB_HOST=127.0.0.1
DB_PORT=5432

# Broker Credentials
RABBIT_USER=guest
RABBIT_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//

# Security & App Configuration
# Secret key for Django (Generate using: python3 -c "import secret; print(secret.token_urlsafe(50))")
SECRET_KEY=change-me-in-production-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Symmetric Fernet Encryption Key for HA Tokens
# Generate using: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=uwAdrr58WR0vTST0mLh2XyE-qV6uroWkv0MLHuzVW6g=

# Initial Superuser Account
APP_USER=admin
APP_PASS=admin123

# Machine Learning & Workers
#
# EMOTION_MODEL_BACKEND selects which emotion-recognition library to use:
#   emotiefflib  (default) – uses the HSEmotion / EmotiEffLib library.
#                            Set EMOTION_MODEL_NAME to an EmotiEffLib model name,
#                            e.g. enet_b0_8_best_afew, enet_b0_8_best_vgaf, enet_b2_8
#   dima         – uses a HuggingFace `image-classification` pipeline.
#                  Set EMOTION_MODEL_NAME to any compatible HF repo,
#                  e.g. dima806/facial_emotions_image_detection
#
EMOTION_MODEL_BACKEND=emotiefflib
EMOTION_MODEL_NAME=enet_b0_8_best_afew
FACE_DETECTOR_MODEL_NAME=arnabdhar/YOLOv8-Face-Detection
CELERY_WORKER_CONCURRENCY=2
MOCK_HA=false

